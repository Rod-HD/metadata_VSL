# Project-local virtual environment and caches (kept on D:, never committed)
.venv/
.pip-cache/

# Large media and generated artifacts (never committed).
# NOTE: ignore the *contents* of processed_videos with /* (not the dir itself),
# so the split_variants/ subtree below can be re-included as a tracked deliverable.
Dataset/processed_videos/*
Dataset/raw_videos/
Dataset/by_signer/
Dataset/models/

# Exception: keep the multi-variant splitter LABELS as a tracked deliverable, but
# not the clip .mp4s themselves (a full 1000-video run is ~634 MB of binaries).
!Dataset/processed_videos/split_variants/
Dataset/processed_videos/split_variants/*.mp4
Dataset/labels/vsl400/*.zip
Dataset/final_dataset/embeddings.npz
Dataset/final_dataset/clip_store.json
Dataset/final_dataset/clip_store_embeddings.npz
Dataset/final_dataset/signer_registry.json

# Python bytecode
__pycache__/
*.pyc

# Editor / tooling workspace metadata (not part of the deliverable)
.kiro/
.vscode/
.idea/

# Local-only personal guide / scratch runners (never committed)
HUONG_DAN_CHI_TIET.md
run_custom.py
run_*.py

# Tooling caches (kept on D:, never committed)
.pytest_cache/
.hypothesis/

# Run logs, intermediate artifacts, and large reference docs
Dataset/logs/
Dataset/extracted_keypoints/
*.pdf
